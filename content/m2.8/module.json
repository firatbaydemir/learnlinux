   "/home/student/reports/ping_sample.txt": "PING 1.1.1.1 (1.1.1.1) 56(84) bytes of data.\n\n--- 1.1.1.1 ping statistics ---\n4 packets transmitted, 0 received, 100% packet loss, time 3070ms\n",
   "/home/student/reports/ip_sample.txt": "lo      UNKNOWN  127.0.0.1/8\neth0    UP       192.168.1.50/24\n",
   "/home/student/logs/app.log": "INFO start\nERROR write failed\nINFO retry\n",
   "/home/student/logs/old_debug.log": "debug line 1\ndebug line 2\n",
   "/home/student/logs/core.dump": "binary-placeholder\n"
