 },
 "tasks": [
  {"id": "t01", "kind": "warmup", "diff": 1, "check": {"cmd": "^df -h$", "ok": true}, "solution": ["df -h"]},
  {"id": "t02", "kind": "warmup", "diff": 1, "check": {"cmd": "^free -h$", "ok": true}, "solution": ["free -h"]},
  {"id": "t03", "kind": "warmup", "diff": 1, "check": {"cmd": "^uptime$", "ok": true}, "solution": ["uptime"]},
  {"id": "t04", "kind": "guided", "diff": 2, "check": {"out": "Use%", "of": "^cat "}, "solution": ["cat ~/reports/df_sample.txt"]},
  {"id": "t05", "kind": "guided", "diff": 2, "check": {"contains": ["~/disk_report.txt", "Mounted on"]}, "solution": ["df -h > ~/disk_report.txt"]},
  {"id": "t06", "kind": "guided", "diff": 2, "check": {"contains": ["~/disk_report.txt", "Swap"]}, "solution": ["free -h >> ~/disk_report.txt"]},
  {"id": "t07", "kind": "guided", "diff": 2, "check": {"contains": ["~/disk_report.txt", "load average"]}, "solution": ["uptime >> ~/disk_report.txt"]},
  {"id": "t08", "kind": "predict", "diff": 2, "check": {"out": "/var", "of": "^grep .*95%"}, "solution": ["grep 95% ~/reports/df_sample.txt"]},
  {"id": "t09", "kind": "predict", "diff": 2, "check": {"out": "100% packet loss", "of": "^(cat|grep|tail) "}, "solution": ["grep loss ~/reports/ping_sample.txt"]},
  {"id": "t10", "kind": "predict", "diff": 2, "check": {"out": "192\\.168\\.1\\.50", "of": "^grep "}, "solution": ["grep eth0 ~/reports/ip_sample.txt"]},
  {"id": "t11", "kind": "debug", "diff": 2, "check": [{"absent": "~/logs/old_debug.log"}, {"exists": "~/logs/app.log", "type": "f"}], "solution": ["rm ~/logs/old_debug.log"]},
  {"id": "t12", "kind": "mini", "diff": 2, "check": {"contains": ["~/health.txt", "(?=[\\s\\S]*== disk ==)(?=[\\s\\S]*Mounted on)(?=[\\s\\S]*== memory ==)(?=[\\s\\S]*Swap)"]}, "solution": ["echo \"== disk ==\" > ~/health.txt", "df -h >> ~/health.txt", "echo \"== memory ==\" >> ~/health.txt", "free -h >> ~/health.txt"]},
  {"id": "t13", "kind": "challenge", "diff": 3, "check": [{"contains": ["~/alert.txt", "/var"]}, {"contains": ["~/alert_count.txt", "1"]}], "solution": ["grep 95% ~/reports/df_sample.txt > ~/alert.txt", "grep -c 95% ~/reports/df_sample.txt > ~/alert_count.txt"]},
  {"id": "t14", "kind": "ticket", "diff": 3, "check": [{"contains": ["~/full_mount.txt", "/var"]}, {"absent": "~/logs/core.dump"}], "solution": ["echo /var > ~/full_mount.txt", "rm ~/logs/core.dump"]}
 ],
